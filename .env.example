# ==============================================================================
#  TRAVEZY PRODUCTION & STAGING ENVIRONMENT VARIABLES (.env.example)
# ==============================================================================
# Copy this file to .env and replace placeholder values with your real credentials.
# NEVER commit your real .env file or API keys to version control.

# ------------------------------------------------------------------------------
# 1. NODE / RUNTIME ENVIRONMENT
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=3000

# ------------------------------------------------------------------------------
# 2. SUPABASE (Database, Auth, Storage, Realtime)
# ------------------------------------------------------------------------------
# Public Project URL (e.g. https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_URL=https://your-project-ref.supabase.co

# Public Anon / Publishable Key (Safe for frontend bundle)
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_anon_key_here
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_anon_key_here

# Service Role Key (CONFIDENTIAL: Used strictly by server functions / SSR for admin tasks)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here

# Optional Direct PostgreSQL Connection String for external query tools / Prisma
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project-ref.supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# 3. RAZORPAY (Payment Gateway)
# ------------------------------------------------------------------------------
# Razorpay Key ID (Test key: rzp_test_... | Live key: rzp_live_...)
VITE_RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id
RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id

# Razorpay Key Secret (CONFIDENTIAL: Never exposed to client)
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Razorpay Webhook Secret (Optional, for asynchronous webhook verification)
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ------------------------------------------------------------------------------
# 4. MAPBOX (Interactive Maps & Geocoding)
# ------------------------------------------------------------------------------
# Mapbox Public Access Token (pk.eyJ1...)
VITE_MAPBOX_TOKEN=pk.eyJ1IjoieW91ci11c2VybmFtZSIsImEiOiJ5b3VyLXRva2VuIn0.your_signature

# ------------------------------------------------------------------------------
# 5. CLOUDINARY (Media & Image Upload CDN)
# ------------------------------------------------------------------------------
# Cloudinary Cloud Name (e.g. travezy-cloud)
VITE_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name

# Cloudinary API Key (Public key identifier)
VITE_CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_KEY=your_cloudinary_api_key

# Cloudinary API Secret (CONFIDENTIAL: Server-side signature generation)
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Cloudinary Upload Preset (Unsigned preset name in Cloudinary settings, e.g. travezy_uploads)
VITE_CLOUDINARY_UPLOAD_PRESET=travezy_uploads
CLOUDINARY_UPLOAD_PRESET=travezy_uploads

# ------------------------------------------------------------------------------
# 6. AI ASSISTANT & TRANSLATOR
# ------------------------------------------------------------------------------
# Google Gemini or OpenAI API Key for AI Travel Guide and Language Translation
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# ------------------------------------------------------------------------------
# 7. TRANSACTIONAL NOTIFICATIONS (Email & SMS Dispatch)
# ------------------------------------------------------------------------------
# Resend API Key for Transactional HTML Emails (e.g. re_123456789)
RESEND_API_KEY=re_your_resend_api_key_here
NOTIFICATION_FROM_EMAIL=notifications@travezy.com

# Twilio Credentials for Transactional SMS Alerts
TWILIO_ACCOUNT_SID=AC_your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890
